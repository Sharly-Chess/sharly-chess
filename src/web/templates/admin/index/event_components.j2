{% import '/admin/components/macros.j2' as components with context %}

{% macro item_class(item, view) -%}
    {%- if not item.accessible or not item.are_all_plugins_enabled -%}
        collection-status-danger
    {%- elif item.public -%}
        collection-status-public
    {%- else -%}
        collection-status-private
    {%- endif -%}
{%- endmacro %}

{% macro row_href(item, view, placement) %}
    {% if item.accessible and item.are_all_plugins_enabled %}
        {{ url_for('admin-event', event_uniq_id=item.uniq_id) }}
    {% endif %}
{% endmacro %}

{% macro identity(item, view, placement) %}
    <span class="{% if view == 'list' %}d-flex{% else %}d-inline-flex{% endif %} align-items-center gap-2 min-width-0">
        {% if view == 'list' and not hide_public_status|default(false) %}
            {{ macros.visibility_icon('event', item.public, class='flex-shrink-0') }}
        {% endif %}
        <span class="fw-bold {% if view == 'list' %}text-truncate min-width-0{% else %}collection-card-title{% endif %}">
            {{ item.name }}
        </span>
        {% if not item.accessible %}
            <i
                class="bi-lock-fill text-danger"
                {{ macros.tooltip_attributes(
                    'warning',
                    _(
                        'This event exists on the server but could not be opened. It '
                        'may be locked by another program, by file synchronisation '
                        '(OneDrive, Google Drive, DropBox, etc.) or by antivirus software.'
                    ),
                    'top',
                ) }}
            ></i>
        {% elif not item.are_all_plugins_enabled %}
            <i
                class="bi-exclamation-triangle-fill text-danger"
                {{ macros.tooltip_attributes(
                    'warning', item.inaccessible_tooltip_message, 'top'
                ) }}
            ></i>
        {% endif %}
    </span>
{% endmacro %}

{% macro date_range(item, view, placement) %}
    {% set is_range = view == 'list' and item.stop_date and item.start_date != item.stop_date %}
    <span class="{% if not item.tournament_count %}fst-italic text-secondary{% endif %} d-inline-flex align-items-center gap-2 text-nowrap {% if is_range %}collection-date-stacked{% endif %}">
        <i class="bi-calendar-range text-secondary"></i>
        {% if is_range %}
            <span class="d-flex flex-column">
                <span>{{ format_date(item.start_date) }}</span>
                <span>{{ format_date(item.stop_date) }}</span>
            </span>
        {% else %}
            <span>{{ format_date_range(item.start_date, item.stop_date) }}</span>
        {% endif %}
        {% if not item.tournament_count %}<span>({{ _('default') }})</span>{% endif %}
    </span>
{% endmacro %}

{% macro unique_id(item, view, placement) %}
    <div class="collection-fact">
        <span class="collection-fact-label"><i class="bi-question-circle-fill"></i>{{ _('Unique ID') }}</span>
        {{ item.uniq_id }}
    </div>
{% endmacro %}

{% macro visibility(item, view, placement) %}
    {% if not hide_public_status|default(false) %}
        {% if item.public %}
            <span
                class="text-visibility-public text-nowrap"
                {{ macros.tooltip_attributes('info', _('This event is public (by default, screens are visible by the spectators).'), 'top') }}
            >{% call components.icon_text('bi-eye-fill') %}{{ _('Public') }}{% endcall %}</span>
        {% else %}
            <span
                class="text-visibility-private text-nowrap"
                {{ macros.tooltip_attributes('info', _('This event is private (by default, screens are not visible by the spectators).'), 'top') }}
            >{% call components.icon_text('bi-eye-slash-fill') %}{{ _('Private') }}{% endcall %}</span>
        {% endif %}
    {% endif %}
{% endmacro %}

{% macro tournaments_count(item, view, placement) %}
    {% call components.icon_text('bi-diagram-3', class='text-nowrap' ~ (' text-secondary' if not item.tournament_count else '')) %}{{ item.tournament_count }}{% endcall %}
{% endmacro %}

{% macro players_count(item, view, placement) %}
    {% call components.icon_text('bi-people', class='text-nowrap' ~ (' text-secondary' if not item.player_count else '')) %}{{ item.player_count }}{% endcall %}
{% endmacro %}

{% macro teams_count(item, view, placement) %}
    {% if item.is_team_event %}
        <span
            class="{% if not item.team_count %}text-secondary{% endif %} text-nowrap"
            {{ macros.tooltip_attributes('info', _('Number of teams: %(num)d', num=item.team_count), 'top') }}
        >
            {% call components.icon_text('bi-flag') %}{{ item.team_count }}{% endcall %}
        </span>
    {% endif %}
{% endmacro %}

{% macro event_type(item, view, placement) %}
    {% if item.is_team_event %}
        <span
            class="text-nowrap"
            {{ macros.tooltip_attributes('info', _('Number of teams: %(num)d', num=item.team_count), 'top') }}
        >
            {% call components.icon_text('bi-flag') %}{{ _('Team') }} <span class="{% if not item.team_count %}text-secondary{% endif %}">({{ item.team_count }})</span>{% endcall %}
        </span>
    {% else %}
        {% call components.icon_text('bi-person', class='text-nowrap') %}{{ _('Individual') }}{% endcall %}
    {% endif %}
{% endmacro %}

{% macro tags(item, view, placement) %}
    {% if view == 'card' %}
        {% if item.tags %}
            <div class="collection-fact">
                <span class="collection-fact-label"><i class="bi-tags"></i>{{ _('Tags') }}</span>
                {{ components.tag_badges(item.tags) }}
            </div>
        {% endif %}
    {% else %}
        {{ components.tag_badges(item.tags) }}
    {% endif %}
{% endmacro %}

{% macro plugin_health(item, view, placement) %}
    {% if client.can_manage_events and item.enabled_plugins %}
        <div class="collection-fact">
            <span class="collection-fact-label"><i class="bi-plugin"></i>{{ _('Plugins') }}</span>
            <span>
                <span>{{ item.enabled_plugins|length }}</span>
                <i
                    class="{% if item.are_all_plugins_enabled %}bi-info-circle-fill{% else %}bi-exclamation-triangle-fill text-danger{% endif %} ps-1"
                    {{ macros.tooltip_attributes('', item.plugins_tooltip_message, 'right') }}
                ></i>
            </span>
        </div>
    {% endif %}
{% endmacro %}

{% macro details(item, view, placement) %}
    {% set show_plugin_details = view != 'card' and client.can_manage_events and item.enabled_plugins %}
    <div
        class="collection-details-grid
            {% if view == 'card' %}
                collection-details-grid-single
            {% elif show_plugin_details %}
                collection-details-grid-triple
            {% endif %}"
    >
        <section class="collection-detail-section">
            <h6>{{ _('Organisation') }}</h6>
            {% call components.icon_text('bi-building', tag='div', class='' if item.organiser_name else 'text-secondary') %}
                {{ item.organiser_name or _('No organiser') }}
            {% endcall %}
            {% call components.icon_text('bi-person-bounding-box', tag='div', class='' if item.organiser_director else 'text-secondary') %}
                {{ item.organiser_director or _('No director') }}
            {% endcall %}
            {% call components.icon_text('bi-envelope', tag='div', class='' if item.organiser_email else 'text-secondary') %}
                {% if item.organiser_email %}
                    <a href="mailto:{{ item.organiser_email }}">{{ item.organiser_email }}</a>
                {% else %}
                    {{ _('No email') }}
                {% endif %}
            {% endcall %}
            {% call components.icon_text('bi-box-arrow-up-right', tag='div', class='' if item.organiser_home_page else 'text-secondary') %}
                {% if item.organiser_home_page %}
                    <a href="{{ item.organiser_home_page }}" target="_blank">{{ item.organiser_home_page }}</a>
                {% else %}
                    {{ _('No home page') }}
                {% endif %}
            {% endcall %}
        </section>
        <section class="collection-detail-section">
            <h6>{{ _('Event content') }}</h6>
            {% if item.is_team_event %}
                {% call components.icon_text('bi-flag', tag='div') %}{{ _('Teams: %(num)d', num=item.team_count) }}{% endcall %}
            {% endif %}
            {% call components.icon_text('bi-clock', tag='div') %}{{ _('Timers: %(num)d', num=item.timer_count) }}{% endcall %}
            {% call components.icon_text('bi-fullscreen', tag='div') %}{{ _('Screens: %(num)d', num=item.screen_count) }}{% endcall %}
            {% call components.icon_text('bi-arrows-fullscreen', tag='div') %}{{ _('Multi-screens: %(num)d', num=item.family_count) }}{% endcall %}
            {% call components.icon_text('bi-repeat', tag='div') %}{{ _('Rotators: %(num)d', num=item.rotator_count) }}{% endcall %}
            {% if item.origin_message %}
                {% call components.icon_text('bi-clock-history', tag='div', class='text-secondary mt-2') %}{{ item.origin_message }}{% endcall %}
            {% endif %}
        </section>
        {% if show_plugin_details %}
            <section class="collection-detail-section">
                <h6>{{ _('Plugins') }}</h6>
                <div class="d-flex flex-column gap-1">
                    {% for plugin in item.plugins %}
                        <div class="{% if not plugin.is_enabled %}text-danger fw-bold{% endif %}">
                            {% if plugin.is_enabled %}
                                {{ plugin.name }}
                            {% else %}
                                {{ _('{plugin} (disabled)').format(plugin=plugin.name) }}
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
{% endmacro %}

{% macro snapshots_button(event, view, label) %}
    {{ components.modal_button(
        url_for('event-snapshots-modal', event_uniq_id=event.uniq_id),
        label or _('View the backups of the event.'),
        icon='bi-clock-history',
        icon_only=not label,
        size='sm',
        tooltip=_('View the backups of the event.'),
        attrs={'hx-push-url': 'false'},
    ) }}
{% endmacro %}

{% macro actions(item, view, placement) %}
    {% set event = item %}
    {% if not event.accessible and client.can_manage_events %}
        {# An event that could not be opened is reachable nowhere else, so what
           can be done with it is offered where it is listed: brought back from
           a backup, or archived and set aside. #}
        <div class="collection-actions d-flex align-items-center justify-content-end gap-2">
            {{ snapshots_button(event, view, _('Restore')) }}
            {{ components.modal_button(
                url_for(
                    'admin-event-damaged-delete-modal',
                    admin_tab=admin_tab,
                    event_uniq_id=event.uniq_id,
                ),
                _('Archive the event.'),
                kind='outline-danger',
                icon='bi-archive',
                icon_only=true,
                size='sm',
                attrs={'hx-push-url': 'false'},
            ) }}
        </div>
    {% elif event.accessible and event.are_all_plugins_enabled and (client.can_manage_events or client.can_create_events) %}
        <div class="collection-actions d-flex align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-1">
                {% if client.can_manage_events %}
                    {{ components.modal_button(
                        url_for('event-export-modal', event_uniq_id=event.uniq_id),
                        _('Export'),
                        icon='bi-box-arrow-right',
                        icon_only=view != 'card',
                        size='sm',
                        tooltip=_('Export event in SCE format'),
                        attrs={'hx-push-url': 'false'},
                    ) }}
                    {{ snapshots_button(
                        event, view, _('Backups') if view == 'card' else ''
                    ) }}
                {% endif %}
            </div>
            <div class="d-flex align-items-center gap-1">
                {% if client.can_manage_events %}
                    {{ components.modal_button(
                        url_for(
                            'admin-event-modal',
                            admin_tab=admin_tab,
                            event_uniq_id=event.uniq_id,
                            action='update',
                        ),
                        _('Edit the properties of the event.'),
                        icon='edit',
                        icon_only=true,
                        size='sm',
                        attrs={'hx-push-url': 'false'},
                    ) }}
                {% endif %}
                {% if client.can_create_events %}
                    {{ components.modal_button(
                        url_for(
                            'admin-event-modal',
                            admin_tab=admin_tab,
                            event_uniq_id=event.uniq_id,
                            action='clone',
                        ),
                        _('Duplicate the event.'),
                        icon='copy',
                        icon_only=true,
                        size='sm',
                        attrs={'hx-push-url': 'false'},
                    ) }}
                {% endif %}
                {% if client.can_manage_events %}
                    {{ components.modal_button(
                        url_for(
                            'admin-event-delete-modal',
                            admin_tab=admin_tab,
                            event_uniq_id=event.uniq_id,
                        ),
                        _('Archive the event.'),
                        kind='outline-danger',
                        icon='bi-archive',
                        icon_only=true,
                        size='sm',
                        attrs={'hx-push-url': 'false'},
                    ) }}
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endmacro %}
