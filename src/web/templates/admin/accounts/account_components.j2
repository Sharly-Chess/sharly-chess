{% macro item_class(item, view) -%}
    {%- if item.administrator -%}
        collection-status-primary
    {%- elif item.anonymous -%}
        collection-status-secondary
    {%- elif item.active -%}
        collection-status-success
    {%- else -%}
        collection-status-danger
    {%- endif -%}
{%- endmacro %}

{% macro identity(item, view, placement) %}
    {% if item.administrator %}
        <span class="d-inline-flex align-items-center gap-2 fw-bold">
            <i class="bi-person-gear"></i>{{ item.full_name }}
        </span>
    {% elif item.anonymous %}
        <span class="d-inline-flex align-items-center gap-2 fst-italic">
            <i class="bi-incognito"></i>{{ _('Anonymous') }}
        </span>
    {% else %}
        <span class="fw-bold text-truncate d-block">{{ item.get_card_title(admin_event) }}</span>
    {% endif %}
{% endmacro %}

{% macro card_identity(item, view, placement) %}
    {% if item.administrator %}
        <i
            class="bi-person-gear pe-1"
            {{ macros.tooltip_attributes(
                'info', _('The account of the user accessing Sharly Chess directly from the server.'), 'top'
            ) }}
        ></i>
        <b>{{ item.full_name }}</b>
    {% elif item.anonymous %}
        <i
            class="bi-incognito pe-1"
            {{ macros.tooltip_attributes(
                'info', _('The account matching all the users not logged in to any account.'), 'top'
            ) }}
        ></i>
        <i>{{ _('Anonymous') }}</i>
    {% else %}
        {% if item.active %}
            <i
                class="bi-person-check text-success pe-1"
                {{ macros.tooltip_attributes(
                    'info', _('This account is active, anonymous users can log in to it.'), 'right'
                ) }}
            ></i>
        {% else %}
            <i
                class="bi-person-x text-danger pe-1"
                {{ macros.tooltip_attributes(
                    'info', _('This account is not active, anonymous users can not log in to it.'), 'right'
                ) }}
            ></i>
        {% endif %}
        {{ item.get_card_title(admin_event) }}
    {% endif %}
{% endmacro %}

{% macro status(item, view, placement) %}
    {% if item.administrator %}
        {% call components.icon_text('bi-shield-fill-check', class='text-primary text-nowrap') %}{{ _('System') }}{% endcall %}
    {% elif item.anonymous %}
        {% call components.icon_text('bi-incognito', class='text-secondary text-nowrap') %}{{ _('Anonymous') }}{% endcall %}
    {% elif item.active %}
        <span
            class="text-success text-nowrap"
            {{ macros.tooltip_attributes('info', _('This account is active, anonymous users can log in to it.'), 'top') }}
        >{% call components.icon_text('bi-person-check') %}{{ pgettext('active account', 'Active') }}{% endcall %}</span>
    {% else %}
        <span
            class="text-danger text-nowrap"
            {{ macros.tooltip_attributes('info', _('This account is not active, anonymous users can not log in to it.'), 'top') }}
        >{% call components.icon_text('bi-person-x') %}{{ pgettext('inactive account', 'Inactive') }}{% endcall %}</span>
    {% endif %}
{% endmacro %}

{% macro roles_summary(item, view, placement) %}
    {% if item.roles %}
        <span class="{% if view == 'list' %}text-truncate{% endif %}">
            {{ item.roles|map(attribute='role_type')|join(', ') }}
        </span>
    {% elif item.user_account %}
        <span class="text-secondary">{{ _('None') }}</span>
    {% else %}
        <span class="text-secondary">{{ _('No role required') }}</span>
    {% endif %}
{% endmacro %}

{% macro permissions_button(account, show_label=false) %}
    {% set client_can_manage_account = client.can_manage_account(account.id) %}
    {{ components.modal_button(
        url_for(
            'admin-account-permissions-modal'
            if account.permissions
            else 'admin-account-permission-create-modal',
            event_uniq_id=admin_event.uniq_id,
            account_id=account.id,
        ),
        _('Permissions'),
        icon='bi-shield-check',
        icon_only=not show_label,
        size='sm',
        allowed=account.edit_permissions and client_can_manage_account,
        reason=_('The permissions of this account can not be updated.')
        if not account.edit_permissions
        else _('You are not allowed to update the permissions of this account.'),
        tooltip=_('Edit the permissions of the account.'),
    ) }}
{% endmacro %}

{% macro permissions_tooltip(account) %}
    {% if account.administrator %}
        {{ _('The administrator has all the permissions.') }}
    {% elif account.sorted_permissions %}
        {% for permission in account.sorted_permissions %}
            {% set access_level = permission.access_level %}
            <div class='text-start{% if not loop.first %} mt-2{% endif %}'>
                <strong>{{ access_level.card_name }}</strong>
                {% if access_level.has_tournament_scope and admin_event.tournaments|length > 1 %}
                    {% if permission.tournament_ids %}
                        <div class='ps-2'>{{ permission.tournaments_tooltip_message(admin_event) }}</div>
                    {% else %}
                        <div class='ps-2 text-secondary'>{{ _('all the tournaments') }}</div>
                    {% endif %}
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        {{ _('No permissions defined.') }}
    {% endif %}
{% endmacro %}

{% macro permissions_summary(item, view, placement) %}
    <span class="account-permissions-summary">
        {% if item.administrator %}
            <span
                class="text-success text-nowrap"
                {{ macros.tooltip_attributes('', permissions_tooltip(item), 'top') }}
            >{% call components.icon_text('bi-shield-fill-check') %}{{ _('All') }}{% endcall %}</span>
        {% elif item.permissions %}
            <span
                class="text-nowrap"
                {{ macros.tooltip_attributes('', permissions_tooltip(item), 'top') }}
            >
                {% call components.icon_text('bi-shield-check', icon_class='text-secondary') %}{{ item.permissions|length }}{% endcall %}
            </span>
        {% else %}
            <span
                class="text-secondary text-nowrap"
                {{ macros.tooltip_attributes('', permissions_tooltip(item), 'top') }}
            >{{ _('None') }}</span>
        {% endif %}
        {% if view == 'list' %}{{ permissions_button(item) }}{% endif %}
    </span>
{% endmacro %}

{% macro card_body(item, view, placement) %}
    {% if not show_details %}
        {% set account = item %}
        {% set tournament_count = admin_event.tournaments|length %}
        <div class="d-flex flex-column gap-1">
            {% if not account.roles and account.user_account %}
                <div class="text-secondary">
                    {{ _('No roles defined') }}
                </div>
            {% else %}
                {% for role in account.roles %}
                    <div>
                        {{ role.role_type }}
                        {% if role.role_type.is_tournament_bound and tournament_count > 1 %}
                            {% set tournament_names = role.tournament_names(admin_event) %}
                            {% if tournament_count == tournament_names|length %}
                                <i class="text-secondary">
                                    ({{ _('all the tournaments') }})
                                </i>
                            {% else %}
                                <i class="text-secondary">
                                    ({{ ngettext(
                                        '%(num)d tournament',
                                        '%(num)d tournaments',
                                        tournament_names|length
                                    ) }})
                                </i>
                                <i
                                    class="bi-info-circle-fill ps-1"
                                    {{ macros.tooltip_attributes(
                                        '', role.tournaments_tooltip_message(admin_event), 'right'
                                    ) }}
                                ></i>
                            {% endif %}
                        {% endif %}
                    </div>
                {% endfor %}
            {% endif %}

            {% if account.administrator %}
                {{ _('The administrator has all the permissions.') }}
            {% elif not account.permissions %}
                <div class="text-warning">
                    {{ _('No permissions defined.') }}
                </div>
            {% else %}
                {{ _('%(string)s:', string=_('Permissions')) }}
                <ul class="mb-0">
                    {% for permission in account.sorted_permissions %}
                        {% set access_level = permission.access_level %}
                        <li>
                            <span {{ macros.tooltip_attributes('info', access_level.help_text, 'left') }}>
                                {{ access_level.card_name }}
                            </span>
                            {% if access_level.has_tournament_scope and tournament_count > 1 %}
                                {% if permission.tournament_ids %}
                                    <i class="text-secondary">
                                        ({{ ngettext(
                                            '%(num)d tournament',
                                            '%(num)d tournaments',
                                            permission.tournament_ids|length
                                        ) }})
                                    </i>
                                    <i
                                        class="bi-info-circle-fill ps-1"
                                        {{ macros.tooltip_attributes(
                                            '', permission.tournaments_tooltip_message(admin_event), 'right'
                                        ) }}
                                    ></i>
                                {% else %}
                                    <i class="text-secondary">
                                        ({{ _('all the tournaments') }})
                                    </i>
                                {% endif %}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}

{% macro details(item, view, placement) %}
    {% set account = item %}
    {% set tournament_count = admin_event.tournaments|length %}
    <div class="collection-details-grid">
        <section class="collection-detail-section">
            <h6>{{ _('Roles') }}</h6>
            {% if account.roles %}
                {% for role in account.roles %}
                    <div>
                        <strong>{{ role.role_type }}</strong>
                        {% if role.role_type.is_tournament_bound and tournament_count > 1 %}
                            {% set tournament_names = role.tournament_names(admin_event) %}
                            {% if tournament_count == tournament_names|length %}
                                <span class="text-secondary">({{ _('all the tournaments') }})</span>
                            {% elif tournament_names %}
                                <ul class="mb-1">
                                    {% for tournament_name in tournament_names %}<li>{{ tournament_name }}</li>{% endfor %}
                                </ul>
                            {% endif %}
                        {% endif %}
                    </div>
                {% endfor %}
            {% elif account.user_account %}
                <span class="text-secondary">{{ _('None') }}</span>
            {% else %}
                <span class="text-secondary">{{ _('No role required') }}</span>
            {% endif %}
        </section>
        <section class="collection-detail-section">
            <h6>{{ _('Permissions') }}</h6>
            {% if account.administrator %}
                <span class="text-success">{{ _('The administrator has all the permissions.') }}</span>
            {% elif account.sorted_permissions %}
                {% for permission in account.sorted_permissions %}
                    {% set access_level = permission.access_level %}
                    <div>
                        <strong {{ macros.tooltip_attributes('info', access_level.help_text, 'left') }}>
                            {{ access_level.card_name }}
                        </strong>
                        {% if access_level.has_tournament_scope and tournament_count > 1 %}
                            {% if permission.tournament_ids %}
                                <ul>
                                    {% for tournament_name in permission.tournament_names(admin_event) %}
                                        <li>{{ tournament_name }}</li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <span class="text-secondary">({{ _('all the tournaments') }})</span>
                            {% endif %}
                        {% endif %}
                    </div>
                {% endfor %}
            {% else %}
                <span class="text-warning">{{ _('No permissions defined.') }}</span>
            {% endif %}
        </section>
    </div>
{% endmacro %}

{% macro actions(item, view, placement) %}
    {% set account = item %}
    {% set client_can_manage_account = client.can_manage_account(account.id) %}
    <div class="collection-actions d-flex align-items-center justify-content-between gap-2">
        {% if view == 'card' %}{{ permissions_button(account, true) }}{% endif %}
        <div class="d-flex align-items-center gap-1">
            {{ components.modal_button(
                url_for('admin-account-update-modal', event_uniq_id=admin_event.uniq_id, account_id=account.id),
                _('Edit the properties of the account.'),
                icon='edit',
                icon_only=true,
                size='sm',
                allowed=account.edit_properties and client_can_manage_account,
                reason=_('This account can not be updated.')
                if not account.edit_properties
                else _('You are not allowed to update this account.'),
            ) }}
            {{ components.modal_button(
                url_for('admin-account-clone-modal', event_uniq_id=admin_event.uniq_id, account_id=account.id),
                _('Duplicate the account.'),
                icon='copy',
                icon_only=true,
                size='sm',
                allowed=account.edit_properties and client_can_manage_account,
                reason=_('This account can not be duplicated.')
                if not account.edit_properties
                else _('You are not allowed to duplicate this account.'),
            ) }}
            {{ components.modal_button(
                url_for('admin-account-delete-modal', event_uniq_id=admin_event.uniq_id, account_id=account.id),
                _('Delete the account.'),
                kind='outline-danger',
                icon='delete',
                icon_only=true,
                size='sm',
                allowed=account.edit_properties and client_can_manage_account,
                reason=_('This account can not be deleted.')
                if not account.edit_properties
                else _('You are not allowed to delete this account.'),
            ) }}
        </div>
    </div>
{% endmacro %}
