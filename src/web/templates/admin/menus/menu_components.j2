{% macro item_class(item, view) -%}
    collection-status-{{ 'success' if item.menu_items_by_id else 'danger' }}
{%- endmacro %}

{% macro identity(item, view, placement) %}
    <span class="d-inline-flex align-items-center gap-2 min-width-0">
        <span class="fw-bold text-truncate">{{ item.name }}</span>
        {% if not item.menu_items_by_id %}
            <i
                class="bi-exclamation-triangle-fill text-danger"
                {{ macros.tooltip_attributes('warning', _('This menu is empty.'), 'top') }}
            ></i>
        {% endif %}
    </span>
{% endmacro %}

{% macro screens_count(item, view, placement) %}
    <span
        class="text-nowrap"
        data-testid="screens-count"
        {{ macros.tooltip_attributes('info', _('Number of screens'), 'top') }}
    >
        <i class="bi-window pe-1 text-secondary"></i>{{ item.covered_basic_screens|length }}
    </span>
{% endmacro %}

{% macro families_count(item, view, placement) %}
    <span
        class="text-nowrap"
        data-testid="families-count"
        {{ macros.tooltip_attributes('info', _('Number of multi-screens'), 'top') }}
    >
        <i class="bi-window-split pe-1 text-secondary"></i>{{ item.covered_families|length }}
    </span>
{% endmacro %}

{% macro content(item, view, placement) %}
    {% call collection_macros.column_edit_button(
        not client.can_manage_screens,
        url_for(
            'admin-menu-items-modal',
            event_uniq_id=admin_event.uniq_id,
            menu_id=item.id,
        ),
        'info' if client.can_manage_screens else 'warning',
        _('Define the content of the menu.')
        if client.can_manage_screens else
        _('You are not allowed to manage screens.'),
        'collection-inline-edit-label-group',
        false,
    ) %}
        <span class="d-inline-flex align-items-center gap-3">
            {{ screens_count(item, view, placement) }}
            {{ families_count(item, view, placement) }}
        </span>
    {% endcall %}
{% endmacro %}

{% macro details(item, view, placement) %}
    {% set menu = item %}
    {% set screen_types = menu.screen_type_objects %}
    <div class="collection-details-grid {% if view == 'card' %}collection-details-grid-single{% endif %}">
        {% if screen_types %}
            <section class="collection-detail-section">
                <h6>{{ _('Screen types') }}</h6>
                {% for screen_type in screen_types %}
                    <div>
                        {{ macros.screen_type_icon(screen_type, true) }}
                        {{ _('All "%(screen_type)s" screens', screen_type=screen_type.name) }}
                    </div>
                {% endfor %}
            </section>
        {% endif %}
        {% if menu.screens %}
            <section class="collection-detail-section">
                <h6>{{ _('Screens') }}</h6>
                {% for screen in menu.screens %}
                    <div>
                        {% if client.can_manage_screens %}{{ macros.screen_visibility_icon(screen, 'pe-1') }}{% endif %}
                        {{ macros.screen_type_icon(screen.screen_type, true) }}
                        {{ screen.name }}
                    </div>
                {% endfor %}
            </section>
        {% endif %}
        {% if menu.families %}
            <section class="collection-detail-section">
                <h6>{{ _('Multi-Screens') }}</h6>
                {% for family in menu.families %}
                    <div>
                        {% if client.can_manage_screens %}{{ admin_macros.family_visibility_icon(family, 'pe-1') }}{% endif %}
                        {{ macros.screen_type_icon(family.screen_type, true) }}
                        {{ family.display_name }}
                    </div>
                {% endfor %}
            </section>
        {% endif %}
    </div>
{% endmacro %}

{% macro actions(item, view, placement) %}
    {% set menu = item %}
    <div class="collection-actions d-flex align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-1">
            {% if client.can_manage_screens %}
                {% if view == 'card' %}
                    <button
                        class="btn btn-sm btn-outline-primary"
                        hx-get="{{ url_for(
                            'admin-menu-items-modal',
                            event_uniq_id=admin_event.uniq_id,
                            menu_id=menu.id,
                        ) }}"
                        {{ macros.tooltip_attributes('info', _('Define the content of the menu.'), 'top') }}
                    >
                        <i class="bi-window-stack"></i>
                        <span class="ms-1">{{ _('Content') }}</span>
                    </button>
                {% endif %}
                {% if menu.first_screen %}
                    <a
                        class="btn btn-sm btn-outline-primary"
                        href="{{ url_for(
                            'user-screen',
                            event_uniq_id=admin_event.uniq_id,
                            screen_uniq_id=menu.first_screen.uniq_id,
                        ) }}"
                        target="_blank"
                        {{ macros.tooltip_attributes('info', _('View the menu.'), 'top') }}
                    ><i class="bi-eye"></i></a>
                {% endif %}
            {% endif %}
        </div>
        {% if client.can_manage_screens %}
            <div class="d-flex align-items-center gap-1">
                {% call macros.action_tooltip('info', _('Edit the properties of the menu.'), 'top') %}
                    <button
                        class="btn btn-sm btn-outline-primary"
                        hx-get="{{ url_for('admin-menu-update-modal', event_uniq_id=admin_event.uniq_id, menu_id=menu.id) }}"
                        hx-target="body"
                        hx-indicator="#please-wait"
                        data-bs-toggle="modal"
                        data-bs-target="#modal-wrapper"
                    ><i class="bi-pencil-fill"></i></button>
                {% endcall %}
                {% call macros.action_tooltip('info', _('Duplicate the menu.'), 'top') %}
                    <button
                        class="btn btn-sm btn-outline-primary"
                        hx-get="{{ url_for('admin-menu-clone-modal', event_uniq_id=admin_event.uniq_id, menu_id=menu.id) }}"
                        hx-target="body"
                        hx-indicator="#please-wait"
                        data-bs-toggle="modal"
                        data-bs-target="#modal-wrapper"
                    ><i class="bi-copy"></i></button>
                {% endcall %}
                {% call macros.action_tooltip('info', _('Delete the menu.'), 'top') %}
                    <button
                        class="btn btn-sm btn-outline-danger"
                        hx-get="{{ url_for(
                            'admin-menu-delete-modal',
                            action='delete',
                            event_uniq_id=admin_event.uniq_id,
                            menu_id=menu.id,
                        ) }}"
                        hx-target="body"
                        hx-indicator="#please-wait"
                        data-bs-toggle="modal"
                        data-bs-target="#modal-wrapper"
                    ><i class="bi-trash-fill"></i></button>
                {% endcall %}
            </div>
        {% endif %}
    </div>
{% endmacro %}
