{% macro item_class(item, view) -%}
    collection-status-{{ 'success' if item.timer_hours else 'danger' }}
{%- endmacro %}

{% macro identity(item, view, placement) %}
    <span class="fw-bold text-truncate d-block">{{ item.name }}</span>
{% endmacro %}

{% macro hours_count(item, view, placement) %}
    {% set count %}
        <span class="d-inline-flex align-items-center gap-1 text-nowrap {% if not item.timer_hours %}text-danger{% endif %}">
            <i class="bi-calendar-event"></i>
            {{ ngettext('%(num)d time', '%(num)d times', item.timer_hours|length) }}
        </span>
    {% endset %}
    {% if view == 'list' %}
        {% call collection_macros.column_edit_button(
            false,
            url_for(
                'admin-timer-hours-modal',
                action='update',
                event_uniq_id=admin_event.uniq_id,
                timer_id=item.id,
            ),
            'info',
            _('Edit the hours of the timer'),
            'collection-inline-edit-label-group',
        ) %}
            {{ count }}
        {% endcall %}
    {% else %}
        {{ count }}
    {% endif %}
{% endmacro %}

{% macro usage(item, view, placement) %}
    {% set content %}
        <span class="d-inline-flex align-items-center gap-3 text-nowrap">
            <span {{ macros.tooltip_attributes('info', _('Number of screens'), 'top') }}>
                {% call components.icon_text('bi-window', icon_class='text-secondary') %}{{ item.screens|length }}{% endcall %}
            </span>
            <span {{ macros.tooltip_attributes('info', _('Number of multi-screens'), 'top') }}>
                {% call components.icon_text('bi-window-split', icon_class='text-secondary') %}{{ item.families|length }}{% endcall %}
            </span>
            <span {{ macros.tooltip_attributes('info', _('Number of rotators'), 'top') }}>
                {% call components.icon_text('bi-window-stack', icon_class='text-secondary') %}{{ item.rotators|length }}{% endcall %}
            </span>
        </span>
    {% endset %}
    {% if view == 'list' %}
        {% call collection_macros.column_edit_button(
            false,
            url_for(
                'admin-timer-usage-modal',
                event_uniq_id=admin_event.uniq_id,
                timer_id=item.id,
            ),
            'info',
            '',
            'collection-inline-edit-label-group',
            false,
            aria_label=_('Choose the screens that display the timer'),
        ) %}
            {{ content }}
        {% endcall %}
    {% else %}
        {{ content }}
    {% endif %}
{% endmacro %}

{% macro next_hour(item, view, placement) %}
    {% if item.sorted_timer_hours %}
        {% set first_hour = item.sorted_timer_hours|first %}
        <span class="d-inline-flex align-items-center gap-2 {% if view == 'list' %}text-truncate{% endif %}">
            <strong>{{ first_hour.triggered_at_str }}</strong>
            <span class="text-secondary">{{ first_hour.name }}</span>
        </span>
    {% else %}
        {% call components.icon_text('warning', class='text-danger') %}{{ _('No hours') }}{% endcall %}
    {% endif %}
{% endmacro %}

{% macro thresholds(item, view, placement) %}
    <div class="timer-thresholds d-flex flex-column align-items-start gap-0 lh-sm">
        <span class="d-inline-flex align-items-center gap-1 text-nowrap">
            {{ _('%(minutes)d min before', minutes=item.delays[1]) }}
        </span>
        <span class="d-inline-flex align-items-center gap-1 text-nowrap">
            {{ _('%(minutes)d min before', minutes=item.delays[2]) }}
        </span>
        <span class="d-inline-flex align-items-center gap-1 text-nowrap">
            {{ _('%(minutes)d min after', minutes=item.delays[3]) }}
        </span>
    </div>
{% endmacro %}

{% macro details(item, view, placement) %}
    <div class="collection-details-grid">
        <section class="collection-detail-section">
            <h6>{{ _('Scheduled hours') }}</h6>
            {% if not item.timer_hours %}
                {% call components.icon_text('warning', class='text-danger') %}{{ _('No hours.') }}{% endcall %}
            {% endif %}
            {% for date_str, timer_hours in item.timer_hours_by_date_str.items() %}
                <div class="mt-2">
                    {% if timer_hours|length > 1 %}<strong>{{ date_str }}</strong>{% endif %}
                    {% for timer_hour in timer_hours %}
                        <div class="d-flex gap-3">
                            <strong class="text-end" style="min-width: 6rem">
                                {{ timer_hour.triggered_at_str if timer_hours|length == 1 else timer_hour.time_str }}
                            </strong>
                            <span>{{ timer_hour.name }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        </section>
    </div>
{% endmacro %}

{% macro actions(item, view, placement) %}
    {% set timer = item %}
    <div class="collection-actions d-flex flex-wrap align-items-center {% if view == 'card' %}justify-content-between{% else %}justify-content-end{% endif %} gap-2">
        {% if view == 'card' %}
            <div class="d-flex align-items-center gap-1">
                {{ components.modal_button(
                    url_for(
                        'admin-timer-hours-modal',
                        action='update',
                        event_uniq_id=admin_event.uniq_id,
                        timer_id=timer.id,
                    ),
                    _('Hours'),
                    icon='bi-collection',
                    size='sm',
                    tooltip=_('Edit the hours of the timer'),
                ) }}
                {{ components.modal_button(
                    url_for(
                        'admin-timer-usage-modal',
                        event_uniq_id=admin_event.uniq_id,
                        timer_id=timer.id,
                    ),
                    _('Screens'),
                    icon='bi-window',
                    size='sm',
                    tooltip=_('Choose the screens that display the timer'),
                ) }}
            </div>
        {% endif %}
        <div class="d-flex align-items-center gap-1">
            {{ components.modal_button(
                url_for('admin-timer-update-modal', event_uniq_id=admin_event.uniq_id, timer_id=timer.id),
                _('Edit the properties of the timer.'),
                icon='edit',
                icon_only=true,
                size='sm',
            ) }}
            {{ components.modal_button(
                url_for('admin-timer-clone-modal', event_uniq_id=admin_event.uniq_id, timer_id=timer.id),
                _('Duplicate the timer.'),
                icon='copy',
                icon_only=true,
                size='sm',
            ) }}
            {{ components.modal_button(
                url_for('admin-timer-delete-modal', event_uniq_id=admin_event.uniq_id, timer_id=timer.id),
                _('Delete the timer.'),
                kind='outline-danger',
                icon='delete',
                icon_only=true,
                size='sm',
            ) }}
        </div>
    </div>
{% endmacro %}
