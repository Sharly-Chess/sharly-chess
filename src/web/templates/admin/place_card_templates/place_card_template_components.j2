{% import '/admin/components/macros.j2' as components with context %}
{% macro identity(item, view, placement) %}
    <span class="fw-bold text-truncate d-block">{{ item.name }}</span>
{% endmacro %}

{% macro type_badge(item, view, placement) %}
    {{ components.badge('neutral', item.type.static_singular_name()) }}
{% endmacro %}

{# Shown in the cards view body and, expandable, in the list view's details row. #}
{% macro preview(item, view, placement) %}
    {% if view != 'list' and previews.get(item.id) %}
        <div class="pc-template-preview">{{ previews[item.id] | safe }}</div>
    {% endif %}
{% endmacro %}

{% macro actions(item, view, placement) %}
    <div class="collection-actions d-flex align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-1">
            {{ components.button(
                _('Export'),
                icon='download',
                icon_only=view != 'card',
                size='sm',
                tooltip=_('Export'),
                attrs={
                    'data-export-url': url_for('place-card-template-export', template_id=item.id),
                    'onclick': 'downloadFile(this)',
                },
            ) }}
        </div>
        <div class="d-flex align-items-center gap-1">
            {% if not item.embedded %}
                {{ components.button(
                    _('Open editor'),
                    icon='edit',
                    icon_only=true,
                    size='sm',
                    attrs={
                        'hx-get': url_for('place-card-visual-editor', template_id=item.id),
                        'hx-target': 'body',
                        'hx-push-url': 'true',
                        'hx-indicator': '#please-wait',
                    },
                ) }}
            {% endif %}
            {{ components.modal_button(
                url_for('place-card-template-duplicate-modal', template_id=item.id),
                _('Duplicate'),
                icon='copy',
                icon_only=true,
                size='sm',
            ) }}
            {% if not item.embedded %}
                {{ components.modal_button(
                    url_for('place-card-template-delete-modal', template_id=item.id),
                    _('Delete'),
                    kind='outline-danger',
                    icon='delete',
                    icon_only=true,
                    size='sm',
                ) }}
            {% endif %}
        </div>
    </div>
{% endmacro %}
