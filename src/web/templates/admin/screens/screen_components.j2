{% import '/admin/components/macros.j2' as components with context %}
{% import '/admin/families/family_components.j2' as paged with context %}
{% macro item_class(item, view) -%}
    {%- if item.is_paged -%}
        {{ paged.item_class(item, view) }}
    {%- else -%}
        collection-status-{{ 'public' if item.public else 'private' }}
    {%- endif -%}
{%- endmacro %}

{% macro row_href(item, view, placement) %}
{% if item.is_paged %}{% else %}
    {% if not client.can_manage_screens %}
        {{ url_for(
            'user-screen',
            event_uniq_id=admin_event.uniq_id,
            screen_uniq_id=item.uniq_id,
        ) }}
    {% endif %}
{% endif %}
{% endmacro %}

{% macro preview_url(item) %}
{% if item.is_paged %}{{ paged.preview_url(item) }}{% else %}
    {{ url_for('user-screen', event_uniq_id=admin_event.uniq_id, screen_uniq_id=item.uniq_id) }}
{% endif %}
{% endmacro %}

{% macro preview_header(item) %}
    <span class="d-flex align-items-center gap-2 min-width-0">
        {% if item.is_paged %}
            {{ admin_macros.family_visibility_icon(item, '') }}
        {% else %}
            {{ macros.screen_visibility_icon(item, '') }}
        {% endif %}
        <span class="fw-bold text-truncate">{{ item.display_name if item.is_paged else item.name }}</span>
    </span>
    {% if item.display_controllers or item.is_paged or item.accepts_input %}
        <span class="d-flex flex-wrap gap-1">
            {{ input_badge(item) }}
            {% for display_controller in item.display_controllers %}
                {{ components.badge('neutral', display_controller.name) }}
            {% endfor %}
            {% if item.is_paged %}
                {{ components.badge('neutral', ngettext('%(num)d page', '%(num)d pages', item.screens_by_uniq_id|length), icon='bi-window-split') }}
            {% endif %}
        </span>
    {% endif %}
{% endmacro %}

{% macro input_badge(item) %}
    {% if item.accepts_input %}
        {{ components.badge('primary', item.screen_type.input_badge, icon='bi-pencil-square') }}
    {% endif %}
{% endmacro %}

{% macro preview_class(item) -%}
    {%- if item.is_paged %}feed-preview-paged{% endif -%}
{%- endmacro %}

{% macro identity(item, view, placement) %}
{% if item.is_paged %}{{ paged.identity(item, view, placement) }}{% else %}
    <span class="d-inline-flex align-items-center gap-2 min-width-0">
        {% if client.can_manage_screens %}
            {{ macros.screen_visibility_icon(item, '') }}
        {% endif %}
        <span class="fw-bold text-truncate">{{ item.name }}</span>
        {% if item.family %}
            {{ components.badge('neutral', _('Paged Screen')) }}
        {% endif %}
        {{ input_badge(item) }}
        {% if item.display_controllers %}
            {% for display_controller in item.display_controllers %}
                {{ components.badge('neutral', display_controller.name) }}
            {% endfor %}
        {% endif %}
    </span>
{% endif %}
{% endmacro %}

{% macro screen_type(item, view, placement) %}
{% if item.is_paged %}{{ paged.screen_type(item, view, placement) }}{% else %}
    <span class="d-inline-flex align-items-center gap-2 text-nowrap">
        {{ macros.screen_type_icon(item.screen_type, true) }}
        <span class="{% if view == 'list' %}text-truncate{% endif %}">{{ item.type_str }}</span>
    </span>
{% endif %}
{% endmacro %}

{% macro source(item, view, placement) %}
{% if item.is_paged %}{% else %}
    {% if item.family %}
        {% set source_label = (
            item.family.screen_type.family_screen_label(item.sorted_screen_sets[0])
            if view == 'list'
            else item.family.display_name
        ) %}
        <span class="text-truncate" title="{{ source_label }}">
            <i class="bi-window-split pe-1"></i>{{ source_label }}
        </span>
    {% endif %}
{% endif %}
{% endmacro %}

{% macro screen_sets(item, view, placement) %}
{% if item.is_paged %}{{ paged.screen_count(item, view, placement) }}{% else %}
    {% set screen_sets_content %}
        {% if item.screen_type.has_screen_sets %}
            <span class="text-nowrap">
                {% call components.icon_text('bi-collection', icon_class='text-secondary') %}{{ ngettext(
                    '%(num)d set',
                    '%(num)d sets',
                    item.sorted_screen_sets|length,
                ) }}{% endcall %}
            </span>
        {% endif %}
    {% endset %}
    {% if (
        view == 'list'
        and client.can_manage_screens
        and not item.family
        and item.screen_type.has_screen_sets
    ) %}
        {% call collection_macros.column_edit_button(
            false,
            url_for(
                'admin-screen-sets-modal',
                event_uniq_id=admin_event.uniq_id,
                screen_id=item.id,
            ),
            'info',
            _('Edit the sets displayed on the screen.'),
            'collection-inline-edit-label-group',
        ) %}
            {{ screen_sets_content }}
        {% endcall %}
    {% else %}
        {{ screen_sets_content }}
    {% endif %}
{% endif %}
{% endmacro %}

{% macro timer(item, view, placement) %}
{% if item.is_paged %}{{ paged.timer(item, view, placement) }}{% else %}
    {% if item.timer %}
        <span
            class="text-truncate"
            {{ macros.tooltip_attributes('info', _('Timer'), 'top') }}
        ><i class="bi-clock pe-1 text-secondary"></i>{{ item.timer.name }}</span>
    {% else %}
        <span class="text-secondary fst-italic">{{ _('No timer') }}</span>
    {% endif %}
{% endif %}
{% endmacro %}

{% macro summary(item, view, placement) %}
{% if item.is_paged %}{{ paged.summary(item, view, placement) }}{% else %}
    {% set screen = item %}
    {% set screen_type = screen.screen_type %}
    <div class="d-flex flex-column gap-2">
        {% if screen_type.card_config_template %}
            {% include screen_type.card_config_template %}
        {% endif %}
        {% if screen_type.card_template %}
            {% include screen_type.card_template %}
        {% endif %}
    </div>
{% endif %}
{% endmacro %}

{% macro details(item, view, placement) %}
{% if item.is_paged %}{{ paged.details(item, view, placement) }}{% else %}
    {% set screen = item %}
    {% set screen_type = screen.screen_type %}
    <div class="collection-details-grid">
        {% if view != 'card' %}
            {% if screen_type.card_config_template %}
                <section class="collection-detail-section">
                    {% include screen_type.card_config_template %}
                </section>
            {% endif %}
            {% if screen_type.card_template %}
                <section class="collection-detail-section">
                    <h6>{{ _('Content') }}</h6>
                    {% include screen_type.card_template %}
                </section>
            {% endif %}
        {% endif %}
        {% if client.can_view_public_screens and screen_type.card_detail_template %}
            {% set data = screen_type.card_context(screen) %}
            {% if data is not none %}
                <section class="collection-detail-section collection-detail-wide">
                    <h6>{{ _('Display options') }}</h6>
                    {% include screen_type.card_detail_template %}
                </section>
            {% endif %}
        {% endif %}
        {% if client.can_manage_screens %}
            <section class="collection-detail-section collection-detail-wide">
                <h6>{{ _('Alert message') }}</h6>
                {% if screen.message_text %}
                    <div class="screen-alert-message">
                        {{ screen.message_text }}
                        {% if screen.message_default %}
                            <span class="fst-italic">{{ _('(by default)') }}</span>
                        {% endif %}
                    </div>
                {% else %}
                    <span class="text-secondary fst-italic">
                        {{ _('No alert message') }}
                        {% if screen.message_default %}{{ _('(by default)') }}{% endif %}
                    </span>
                {% endif %}
            </section>
        {% endif %}
    </div>
{% endif %}
{% endmacro %}

{% macro actions(item, view, placement) %}
{% if item.is_paged %}{{ paged.actions(item, view, placement) }}{% else %}
    {% set screen = item %}
    {% set screen_type = screen.screen_type %}
    {% if client.can_manage_screens %}
        <div class="collection-actions d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                {% with eye_screen=screen %}
                    {% include '/admin/screens/screen_eye_link.html' %}
                {% endwith %}
                {% if not screen.family and screen_type.card_action_button_template %}
                    {% include screen_type.card_action_button_template %}
                {% endif %}
                {% if view == 'card' and not screen.family and screen_type.has_screen_sets %}
                    {% set _first_set = screen.sorted_screen_sets | first %}
                    {{ components.modal_button(
                        url_for(
                            'admin-screen-sets-modal',
                            event_uniq_id=admin_event.uniq_id,
                            screen_id=screen.id,
                        ),
                        (_('Matches') if _first_set and _first_set.shows_team_matches else _('Boards'))
                        if screen_type.board_based else
                        _('Teams') if admin_event.is_team_event else _('Players'),
                        icon='bi-collection',
                        size='sm',
                        tooltip=(
                            _('Edit the sets of matches displayed on the screen.')
                            if screen_type.board_based else
                            _('Edit the sets of teams displayed on the screen.')
                        )
                        if admin_event.is_team_event else (
                            _('Edit the sets of boards displayed on the screen.')
                            if screen_type.board_based else
                            _('Edit the sets of players displayed on the screen.')
                        ),
                    ) }}
                {% endif %}
                {% if not screen.family %}
                    {{ admin_macros.display_controller_assign_dropdown(
                        admin_event.sorted_display_controllers,
                        'screen',
                        screen.uniq_id,
                        screen.display_controllers,
                    ) }}
                {% endif %}
            </div>
            {% if not screen.family %}
                <div class="d-flex align-items-center gap-1">
                    {{ components.modal_button(
                        url_for('admin-screen-modal', action='update', event_uniq_id=admin_event.uniq_id, screen_id=screen.id),
                        _('Edit the properties of the screen.'),
                        icon='edit',
                        icon_only=true,
                        size='sm',
                    ) }}
                    {{ components.modal_button(
                        url_for('admin-screen-modal', action='clone', event_uniq_id=admin_event.uniq_id, screen_id=screen.id),
                        _('Duplicate the screen.'),
                        icon='copy',
                        icon_only=true,
                        size='sm',
                    ) }}
                    {{ components.modal_button(
                        url_for('admin-screen-modal', action='delete', event_uniq_id=admin_event.uniq_id, screen_id=screen.id),
                        _('Delete the screen.'),
                        kind='outline-danger',
                        icon='delete',
                        icon_only=true,
                        size='sm',
                    ) }}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endif %}
{% endmacro %}
