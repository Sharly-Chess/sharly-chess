{% import '/admin/components/macros.j2' as components with context %}

{% macro _node(key, active, tab, class='', test_id='') %}
    <div
        class="screens-map-node {{ class }}{% if key == active %} active{% endif %}"
        role="link"
        tabindex="0"
        data-testid="screens-map-{{ test_id or key }}"
        data-map-key="{{ key }}"
        {% if key == active %}aria-current="page"{% endif %}
        hx-get="{{ url_for(tab, event_uniq_id=admin_event.uniq_id) }}"
        hx-trigger="click, keyup[key=='Enter']"
        hx-target="body"
        hx-push-url="true"
        hx-indicator="#please-wait"
    >
        {{ caller() }}
    </div>
{% endmacro %}

{% macro _sheets(sheets, turning=false) %}
    <div class="screens-map-sheets{% if turning %} turning{% endif %}" aria-hidden="true">
        {% for sheet in sheets %}
            {% if turning and not loop.first %}<i class="screens-map-track"></i>{% endif %}
            <div class="screens-map-sheet{% if loop.first %} current{% endif %}">
                {% for item in sheet %}
                    {% if item.startswith('bi-') %}<i class="{{ item }}"></i>{% else %}<span>{{ item }}</span>{% endif %}
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{% macro _menu_page() %}
    <div class="screens-map-menu-page" aria-hidden="true">
        <div class="screens-map-sheet screens-map-menu-sheet">
            <div class="screens-map-menu-bar">
                <i class="bi-card-list current"></i><i class="bi-trophy"></i><i class="bi-1-square"></i>
            </div>
            <span class="screens-map-menu-line"></span>
            <span class="screens-map-menu-line short"></span>
        </div>
        <i class="bi-hand-index-fill screens-map-tap"></i>
    </div>
{% endmacro %}

{% macro _timer() %}
    <i class="bi-stopwatch screens-map-timer" aria-hidden="true"></i>
{% endmacro %}

{% macro diagram(active) %}
    <div class="screens-map" role="group" aria-label="{{ _('What can be shown, and how it reaches a device') }}">
        <svg class="screens-map-links" aria-hidden="true"></svg>
        <div class="screens-map-heading screens-map-heading-screens">{{ _('Screens') }}</div>
        <div class="screens-map-heading screens-map-heading-navigation">{{ _('Navigation') }}</div>
        <div class="screens-map-heading screens-map-heading-channels">{{ _('Channels') }}</div>

        {% call _node('screens', active, 'admin-event-screens-tab', 'screens-map-screens') %}
            {{ _timer() }}
            <div class="screens-map-title">{{ pgettext('one screen', 'Screen') }}</div>
            <div class="screens-map-body">
                <div class="screens-map-part">
                    <div class="screens-map-description">{{ _('<b>Multiple</b> tournaments on one page') | safe }}</div>
                    {{ _sheets([['Open A', 'Open B']]) }}
                </div>
                <div class="screens-map-part">
                    <div class="screens-map-description">{{ _('Or <b>one</b> tournament split over several pages') | safe }}</div>
                    {{ _sheets([['A–F'], ['G–M'], ['N–Z']]) }}
                </div>
            </div>
        {% endcall %}

        <div class="screens-map-navigation">
            {% call _node('rotators', active, 'admin-event-rotators-tab', 'screens-map-rotator') %}
                {{ _timer() }}
                <div class="screens-map-title">{{ pgettext('one rotator', 'Rotator') }}</div>
                <div class="screens-map-description">{{ _('Different screens in turn') }}</div>
                {{ _sheets([['bi-card-list'], ['bi-trophy'], ['bi-1-square']], turning=true) }}
            {% endcall %}
            {% call _node('menus', active, 'admin-event-menus-tab', 'screens-map-menu') %}
                <div class="screens-map-title">{{ pgettext('one menu', 'Menu') }}</div>
                <div class="screens-map-description">{{ _('Screens people tap between') }}</div>
                {{ _menu_page() }}
            {% endcall %}
        </div>

        {% call _node('displays', active, 'admin-event-display-controllers-tab', 'screens-map-channel') %}
            <div class="screens-map-title">{{ _('Channel') }}</div>
            <div class="screens-map-body">
                <div class="screens-map-part">
                    <div class="screens-map-description">{{ _('Change what devices show <b>from the arbiter computer</b>') | safe }}</div>
                </div>
                <div class="screens-map-part">
                    <div class="screens-map-description">{{ _('Create one for each place, and let any number of devices follow it') }}</div>
                    <div class="screens-map-examples" aria-hidden="true">
                        <div><span>{{ _('Playing hall') }}</span><i class="bi-tv"></i></div>
                        <div><span>{{ _('Entrance') }}</span><span class="screens-map-tablets"><i class="bi-tablet"></i><i class="bi-tablet"></i><i class="bi-tablet"></i></span></div>
                    </div>
                </div>
            </div>
        {% endcall %}

        <div class="screens-map-devices">
            <div class="screens-map-heading">{{ _('Devices') }}</div>
            <div class="screens-map-device-list" aria-hidden="true">
                <div><i class="bi-tv"></i>{{ _('Big screen') }}</div>
                <div><i class="bi-projector"></i>{{ _('Projector') }}</div>
                <div><span class="screens-map-tablets"><i class="bi-tablet"></i><i class="bi-tablet"></i><i class="bi-tablet"></i></span>{{ _('Tablets') }}</div>
                <div><i class="bi-laptop"></i>{{ _('Computer') }}</div>
            </div>
        </div>
    </div>
    {% call _node('timers', active, 'admin-event-timers-tab', 'screens-map-note') %}
        {% call components.icon_text('bi-stopwatch') %}{{ _('A timer can be added to screens and rotators.') }}{% endcall %}
    {% endcall %}
    <script>drawScreensMaps()</script>
{% endmacro %}

{% macro caption(active) %}
    {% if active == 'displays' %}
        {{ _('A channel is optional. It lets you change what a device shows from the arbiter computer, and any number of devices can follow the same channel.') }}
    {% elif active == 'rotators' %}
        {{ _('A rotator can hold any screen, except check-in and result entry screens.') }}
    {% elif active == 'menus' %}
        {{ _('A menu can hold screens, or all the screens of a type. A screen can be in several menus.') }}
    {% endif %}
{% endmacro %}

{% macro guide(active) %}
    {{ diagram(active) }}
    {% if active in ('displays', 'rotators', 'menus') %}
        <p class="screens-map-caption">{{ caption(active) }}</p>
    {% endif %}
{% endmacro %}

{% macro button(active) %}
    {% if client.can_manage_screens %}
        {{ components.modal_button(
            url_for('admin-screens-map-modal', event_uniq_id=admin_event.uniq_id) ~ '?active=' ~ active,
            _('How this fits together'),
            kind='outline-secondary',
            icon='bi-diagram-3',
            icon_only=true,
            size='sm',
            class='ms-2',
        ) }}
    {% endif %}
{% endmacro %}
