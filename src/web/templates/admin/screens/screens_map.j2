{% import '/admin/components/macros.j2' as components with context %}

{% macro _choice(group, value, icon, title, description, pressed) %}
    <button type="button" class="dx-choice" data-{{ group }}="{{ value }}" data-description="{{ description }}" aria-pressed="{{ 'true' if pressed else 'false' }}">
        <i class="{{ icon }}" aria-hidden="true"></i>{{ title }}
    </button>
{% endmacro %}

{% macro _strings() %}
    {{ {
        'pairings': _('Pairings'),
        'tournament_pairings': _('%(tournament)s pairings', tournament='Open A'),
        'ranking': _('Ranking'),
        'tournament_ranking': _('%(tournament)s ranking', tournament='Open A'),
        'results': _('Last results'),
        'round': _('Round %(round)d', round=3),
        'after_round': _('After round %(round)d', round=2),
        'pages': [
            _('%(first)s to %(last)s', first='A', last='F'),
            _('%(first)s to %(last)s', first='G', last='M'),
            _('%(first)s to %(last)s', first='N', last='Z'),
        ],
        'timer_before': _('Round {round} in {minutes} min {seconds} s'),
        'timer_after': _('Round {round} started'),
        'caption_local': _('Plug a projector or a monitor into this computer and open {what} on it, full screen. No network is needed.'),
        'caption_link': _("The device opens Sharly Chess over the same network: type this computer's network address into its browser, or scan the QR code shown in the Sharly Chess window. Then choose on the device what it shows: {what}."),
        'what_screen': _('the screen'),
        'what_rotator': _('the rotator'),
        'what_menu': _('the menu'),
        'caption_channel': _('The device follows the channel. From the arbiter computer, you decide what the channel shows: a screen, a rotator or a menu. Every device following it shows the same thing, and changes when you change it.'),
        'local_device': _('Projector plugged into this computer'),
        'send_page': _('{screen}, page {page}'),
        'rotator': _('Lobby rotator'),
        'menu': _('Tablets menu'),
        'any_device': _('Any device: TV, projector, tablet, computer'),
        'projector': _('Projector · Playing hall'),
        'tablets': _('Tablets · following the same channel'),
    } | tojson }}
{% endmacro %}

{# *lead*: markup set at the top of the steps column, beside the example
   rather than above it. #}
{% macro diagram(lead=none) %}
    <div class="display-explainer">
        <script type="application/json" class="dx-strings">{{ _strings() }}</script>
        <header class="dx-header">
            <h2>{{ _('Your tournaments, on all your devices') }}{{ macros.doc_icon('screens-guide', 'dx-doc ms-2') }}</h2>
            <p>{{ _('Show pairings, rankings, results and check-in anywhere in the venue: a projector in the playing hall, a TV at the entrance, tablets where players check in or enter their results.') }}</p>
        </header>
        <div class="dx-layout">
            <div class="dx-steps">
                {% if lead %}<div class="dx-lead">{{ lead }}</div>{% endif %}
                <section class="dx-step">
                    <div class="dx-step-head">
                        <span class="dx-num">1</span>
                        <h3>{{ _('The screen') }}</h3>
                    </div>
                    <div class="dx-choices">
                        {{ _choice('layout', 'multi', 'bi-layout-text-window', _('One page, several tournaments'), _('Example: Open A and Open B, one above the other.'), true) }}
                        {{ _choice('layout', 'paged', 'bi-window-split', _('One tournament over several pages'), _('Split automatically; the pages turn by themselves for non-editable screens.'), false) }}
                    </div>
                    <p class="dx-hint" data-hint="layout"></p>
                </section>

                <section class="dx-step">
                    <div class="dx-step-head">
                        <span class="dx-num">2</span>
                        <h3>{{ _('What the device opens') }}</h3>
                    </div>
                    <div class="dx-choices">
                        {{ _choice('open', 'screen', 'bi-window', _('A screen'), _('Just a screen.'), true) }}
                        {{ _choice('open', 'rotator', 'bi-arrow-repeat', _('A rotator'), _('A set of screens displayed in turn, automatically.'), false) }}
                        {{ _choice('open', 'menu', 'bi-list-nested', _('A menu'), _('A set of screens that can be opened manually by clicking on tabs.'), false) }}
                        {{ _choice('open', 'channel', 'bi-broadcast', _('A channel'), _('The arbiter decides what the channel shows and changes it at any time: a screen, a rotator or a menu.'), false) }}
                    </div>
                    <p class="dx-hint" data-hint="open"></p>
                </section>

                <section class="dx-step">
                    <div class="dx-step-head">
                        <span class="dx-num">3</span>
                        <h3>{{ _('The devices') }}</h3>
                    </div>
                    <div class="dx-choices">
                        {{ _choice('via', 'local', 'bi-display', _('This computer'), _('Plug a projector or a monitor into the computer running Sharly Chess: no network needed.'), true) }}
                        {{ _choice('via', 'link', 'bi-router', _('A device on the network'), _("Any tablet, TV or computer on the same network, by typing this computer's network address or scanning its QR code."), false) }}
                    </div>
                    <p class="dx-hint" data-hint="via"></p>
                </section>

                <section class="dx-step dx-optional">
                    <div class="dx-step-head">
                        <span class="dx-num"><i class="bi-stopwatch"></i></span>
                        <h3>{{ _('A timer') }} <small>{{ _('Optional') }}</small></h3>
                    </div>
                    <p class="dx-hint">{{ _('It counts down to the times you give it, such as the start of each round, and can be shown on any screen or rotator.') }}</p>
                    <div class="dx-choices">
                        <button type="button" class="dx-choice" data-timer-toggle aria-pressed="false"><i class="bi-stopwatch" aria-hidden="true"></i>{{ _('Show a timer') }}</button>
                    </div>
                </section>
            </div>

            <div class="dx-stage">
                <p class="dx-stage-label">
                    <b>{{ _('Example') }}</b>
                    <span>{{ _('Change the choices on the left to see how it behaves.') }}</span>
                </p>
                <div class="dx-console" data-console>
                    <span>{{ _('On the arbiter computer, channel') }}</span>
                    <span class="dx-pill">{{ _('Playing hall') }}</span>
                    <span>{{ _('sends:') }}</span>
                    <span class="dx-send" data-send></span>
                </div>
                <div class="dx-devices" data-devices aria-hidden="true"></div>
                <p class="dx-caption" data-caption></p>
            </div>
        </div>
    </div>
    <script>initDisplayExplainers()</script>
{% endmacro %}

{% macro caption(active) %}
    {% if active == 'displays' %}
        {{ _('With a channel, the arbiter decides what devices show. A device follows the channel and shows whatever the arbiter puts on it from the arbiter computer: a screen, a rotator or a menu. Any number of devices can follow the same channel.') }}
    {% elif active == 'screens' %}
        {{ _('A screen shows pairings, rankings, results or check-in for one or more tournaments, on one page or over several pages that turn by themselves.') }}
    {% elif active == 'rotators' %}
        {{ _('A rotator shows several screens in turn on one device, moving to the next one automatically. It can hold any screen except check-in and result entry screens.') }}
    {% elif active == 'menus' %}
        {{ _('A menu puts a bar of buttons at the top of a device, such as a tablet, so that people can tap between its screens. It can hold chosen screens, or all the screens of a type.') }}
    {% elif active == 'timers' %}
        {{ _('A timer counts down to the times you give it, such as the start of each round, on the screens and rotators you choose.') }}
    {% endif %}
{% endmacro %}

{% macro guide(active) %}
    <p class="screens-map-caption">
        {{ caption(active) }}
        <a
            href="{{ url_for('admin-event-display-guide-tab', event_uniq_id=admin_event.uniq_id) }}"
            hx-get="{{ url_for('admin-event-display-guide-tab', event_uniq_id=admin_event.uniq_id) }}"
            hx-target="body"
            hx-push-url="true"
            hx-indicator="#please-wait"
            data-testid="display-guide-link"
        >{{ _('How it all fits together') }}</a>
    </p>
{% endmacro %}
